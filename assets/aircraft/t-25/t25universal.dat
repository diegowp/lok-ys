IDENTIFY "[PRIMU] T-25 AFA"
CATEGORY TRAINER
AFTBURNR FALSE                 #HAVE AFTERBURNER?
PROPELLR 750hp                #PROPELLER ENGINE
WEIGHCLN 1.81t                  #WEIGHT CLEAN
WEIGFUEL 0.37t                 #WEIGHT OF FUEL
WEIGLOAD 1.00t                 #WEIGHT OF PAYLOAD
FUELMILI 0.022kg                #FUEL CONSUMPTION AT MILITARY POWER

COCKPITP  -0.50m  0.90m  0.80m #COCKPIT POSITION
INSTPANL
 

LEFTGEAR -2.00m -1.70m -0.20m  #LEFT LANDING GEAR POSITION
RIGHGEAR  2.00m -1.70m -0.20m  #RIGHT LANDING GEAR POSITION
WHELGEAR  0.00m -1.65m  1.37m  #WHEEL POSITION
ARRESTER  0.00m -1.10m -1.50m  #ARRESTING HOOK POSITION
MACHNGUN 0.00m 0.00m  0.00m  #MACHINE GUN POSITION
SMOKEGEN 1.00m  -1.00m 0.00m  #SMOKE GENERATOR POSITION
VAPORPO0  5.44m  0.015m  0.595m  #VAPOR POSITION (Wings Swept Back or no-VGW)
VAPORPO1  5.44m  0.015m  0.595m  #VAPOR POSITION (Wings Spread)
HTRADIUS  6.5m                #OUTSIDE SPHERE RADIUS

STRENGTH 5

CRITAOAP  16.8deg                #CRITICAL AOA POSITIVE
CRITAOAM -15deg                #CRITICAL AOA NEGATIVE

CRITSPED 260km/h                 #CRITICAL SPEED
MAXSPEED 275km/h                 #MAXIMUM SPEED

HASSPOIL TRUE                 #HAS SPOILER?
RETRGEAR TRUE                 #HAS RETRACTABLE LANDING GEAR?
VARGEOMW TRUE                 #HAS VARIABLE GEOMETRY WING?

CLVARGEO 0.0                   #EFFECT OF VARIABLE GEOMETRY WING FOR Cl
CDVARGEO 0.0                   #EFFECT OF VARIABLE GEOMETRY WING FOR Cd
CLBYFLAP 0.3                   #EFFECT OF FLAP FOR Cl
CDBYFLAP 0.4                   #EFFECT OF FLAP FOR Cd
CDBYGEAR 0.6                   #EFFECT OF GEAR FOR Cd
CDSPOILR 0.0                   #EFFECT OF SPOILER FOR Cd

WINGAREA 17.2m^2               #WING AREA

MXIPTAOA  21.0deg              #MAX INPUT AOA
MXIPTSSA   15.0deg              #MAX INPUT SSA
MXIPTROL 95.0deg              #MAX INPUT ROLL

REM CPITMANE corresponds to Spring Constant K
REM CPITSTAB corresponds to Damper Constant B
REM To be critically damped, B=2*sqrt(K)
REM 2% Settling Time=??

MANESPD1 51kt                  #MINIMUM MANEUVABLE SPEED
MANESPD2 60kt                  #FULLY MANEUVABLE SPEED
CPITMANE 6.0                   #PITCH MANEUVERBILITY CONSTANT
CPITSTAB 2.5                   #PITCH STABILITY CONSTANT
CYAWMANE 4.0                   #YAW MANEUVABILITY CONSTANT
CYAWSTAB 2.5                   #YAW STABILITY CONSTANT
CROLLMAN 2.0                   #ROLL MANEUVABILITY CONSTANT

CTLLDGEA TRUE                  #CONTROL LANDINGGEAR
CTLBRAKE FALSE                 #CONTROL BRAKE
CTLSPOIL 0.0                   #CONTROL SPOILER
CTLABRNR FALSE                 #CONTROL AFTERBURNER
CTLTHROT 0.0                   #CONTROL THRUST
CTLIFLAP 0.0                   #CONTROL FLAP
CTLINVGW 0.0                   #CONTROL VARIABLE GEOMETRY WING
CTLATVGW FALSE                 #CONTROL AUTO VARIABLE GEOMETRY WING

POSITION 0m 3ft 0m             #POSITION
ATTITUDE 45deg 0deg 0deg       #ATTITUDE
INITFUEL 100%                  #INITIAL FUEL
INITLOAD 0.0t                  #INITIAL PAYLOAD
INITSPED 0.0MACH               #INITIAL SPEED

INITIGUN 0                     #INITIAL GUN
INITIAAM 0                     #INITIAL AAM
INITIAGM 0                     #INITIAL AGM
INITBOMB 0                     #INITIAL BOMB
INITRCKT 0                     #INITIAL ROCKET (10kg/each)

SMOKEOIL 30.0kg
WEAPONCH SMK

RADARCRS 0.001

REM ClZero,CdZero is fixed by Cruising condition
REFVCRUS 260km/h               #CRUISING SPEED
REFACRUS 10000ft                #CRUISING ALTITUDE
REFTCRUS 1.0                   #CRUISING THROTTLE SETTING

REM ClSlope,CdConst is fixed by Landing condition
REFVLAND 67kt                 #LANDING SPEED
REFAOALD 10.0deg               #LANDING AOA
REFLNRWY 650m                  #RUNWAY REQUIRED TO STOP
REFTHRLD 0.65                  #LANDING THROTTLE SETTING

AUTOCALC
